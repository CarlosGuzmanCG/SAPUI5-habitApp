<mvc:View
    controllerName="com.cg.habitapp.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
>
    <Shell>
        <Page
            id="page"
            title="{i18n>title}"
        >
            <content>
                <!-- path= Propiedad 

            -->
                <Table
                    items="{
                        path: 'pendientes>/',
                        sorter: {
                            path: 'priority',
                            descending: false
                            }

                    }"
                    mode="Delete"
                    delete=".onDeleteTask"
                >
                    <headerToolbar>
                        <OverflowToolbar>
                            <Button
                                text="Agregar"
                                icon="sap-icon://add-activity"
                                type="Emphasized"
                                press=".onAddTask"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column hAlign="Center">
                            <Title text="Pendientes" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <VBox>
                                    <HBox alignContent="SpaceAround"
                                        visible="{pendientes>editable}">
                                        <VBox alignItems="Start">
                                            <layoutData>
                                                <FlexItemData growFactor="3" />
                                            </layoutData>
                                            <VBox>
                                                <Text text="Titulo" />
                                                <Input
                                                    value="{pendientes>title}"
                                                />
                                            </VBox>
                                            <VBox>
                                                <Text text="Descripción" />
                                                <TextArea
                                                    value="{pendientes>description}"
                                                    rows="3"
                                                    cols="40"
                                                />
                                            </VBox>
                                        </VBox>
                                        <VBox>
                                            <layoutData>
                                                <FlexItemData growFactor="1" />
                                            </layoutData>

                                            <Text text="Creado el" />
                                            <!--DatePicker id="date_created" editable="false" value="{pendientes>date_created}"/-->
                                            <DatePicker
                                                editable="false"
                                                value="{pendientes>date_created}"
                                            />

                                            <Text
                                                text="Fecha inicio planeada"
                                            />
                                            <DatePicker
                                                editable="true"
                                                value="{
                                                    path: 'pendientes>date_start'
                                                    
                                                }"
                                            />

                                            <Text text="Fecha fin" />
                                            <DatePicker
                                                editable="true"
                                                value="{
                                                    path: 'pendientes>due_date'
                                                    
                                                }"
                                            />
                                        </VBox>
                                    </HBox>

                                    <ObjectHeader
                                        title="{pendientes>title}"
                                        number="{pendientes>priority}"
                                        visible="{!pendientes>editable}"
                                        titlePress=".onEdit">
                                        <statuses>
                                            <ObjectStatus
                                                text="In Stock"
                                                state="Success"
                                            />
                                        </statuses>
                                        <ObjectAttribute
                                            title="Descripcion"
                                            text="{pendientes>description}"
                                        />
                                        <ObjectAttribute
                                            title="Fecha Creación"
                                            text="{pendientes>date_created}"
                                        />
                                        <ObjectAttribute
                                            title="Fecha Inicio"
                                            text="{pendientes>date_start}"
                                        />
                                        <ObjectAttribute
                                            title="Fecha Fin"
                                            text="{pendientes>due_date}"
                                        />
                                        
                                    </ObjectHeader>
                                </VBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </content>
        </Page>
    </Shell>
</mvc:View>
