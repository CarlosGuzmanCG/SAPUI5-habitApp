<mvc:View
    controllerName="com.cg.habitapp.controller.MainView"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:dnd="sap.ui.core.dnd"
>
    <Shell>
        <Page
            id="page"
            title="{i18n>title}"
        >
            <content>
                <!-- path= Propiedad 

            -->
                <Table
                    items="{
                        path: 'pendientes>/',
                        sorter: {
                            path: 'priority',
                            descending: false
                            }

                    }"
                    delete=".onDeleteTask"
                    mode="Delete"
                    itemPress=".onListItemPress"
                >
                    <headerToolbar>
                        <OverflowToolbar>
                            <Button
                                text="{i18n>BtAddTask}"
                                icon="sap-icon://add-activity"
                                type="Emphasized"
                                press=".onAddTask"
                            />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column hAlign="Center">
                            <Title text="{i18n>pendings}" />
                        </Column>
                    </columns>

                    <dragDropConfig>
                        <dnd:DragDropInfo
                            sourceAggregation="items"
                            targetAggregation="items"
                            dropPosition="OnOrBetween"
                            drop="onDropReorderTask"
                        />
                    </dragDropConfig>

                    <items>
                        <ColumnListItem
                            press="onPressItem"
                            type="Active"
                        >
                            <cells>
                                <VBox>
                                    <HBox
                                        alignContent="SpaceAround"
                                        visible="{pendientes>editable}"
                                    >
                                        <!--visible="{= ! ${pendientes>editable} }"> False -->
                                        <VBox alignItems="Start">
                                            <layoutData>
                                                <FlexItemData growFactor="3" />
                                            </layoutData>
                                            <VBox>
                                                <Text
                                                    text="{i18n>fieldTTitle}"
                                                    class="customBoldText"
                                                />
                                                <Input
                                                    value="{pendientes>title}"
                                                />
                                            </VBox>
                                            <VBox>
                                                <Text
                                                    text="{i18n>fieldTDescription}"
                                                    class="customBoldText"
                                                />
                                                <TextArea
                                                    value="{pendientes>description}"
                                                    rows="3"
                                                    cols="40"
                                                />
                                            </VBox>
                                        </VBox>
                                        <VBox>
                                            <layoutData>
                                                <FlexItemData growFactor="1" />
                                            </layoutData>

                                            <Text
                                                text="{i18n>fieldCreationDate}"
                                                class="customBoldText"
                                            />
                                            <!--DatePicker id="date_created" editable="false" value="{pendientes>date_created}"/-->
                                            <DatePicker
                                                editable="false"
                                                value="{pendientes>date_created}"
                                                valueFormat="yyyy-MM-dd"
                                            />

                                            <Text
                                                text="{i18n>fieldExFieldStartDate}"
                                                class="customBoldText"
                                            />
                                            <DatePicker
                                                editable="true"
                                                value="{
                                                    path: 'pendientes>date_start'
                                                }"
                                                change=".onDataChange"
                                                valueFormat="yyyy-MM-dd"
                                            />

                                            <Text
                                                text="{i18n>FieldEndDate}"
                                                class="customBoldText"
                                            />
                                            <DatePicker
                                                editable="true"
                                                value="{
                                                    path: 'pendientes>due_date'
                                                    
                                                }"
                                                change=".onDataChange"
                                                valueFormat="yyyy-MM-dd"
                                            />
                                        </VBox>

                                        <VBox justifyContent="Center">
                                            <layoutData>
                                                <FlexItemData growFactor="1" />
                                            </layoutData>
                                            <Button
                                                text="{i18n>BtSave}"
                                                press=".onPressSaveTask"
                                                type="Emphasized"
                                                enabled="{= ! ${pendientes>error} }"
                                            />
                                        </VBox>
                                    </HBox>

                                    <HBox>
                                        <ObjectHeader
                                            title="{pendientes>title}"
                                            class="myObjectHeader"
                                            number="{pendientes>priority}"
                                            visible="{= ! ${pendientes>editable} }"
                                            titlePress=".onEdit"
                                        >
                                            <layoutData>
                                                <FlexItemData growFactor="9" />
                                            </layoutData>

                                            <statuses>
                                                <ObjectStatus
                                                    text="{pendientes>status}"
                                                    state="Success"
                                                    class="myObjectStatus"
                                                />
                                            </statuses>

                                            <ObjectAttribute
                                                title="{i18n>fieldTDescription}"
                                                text="{pendientes>description}"
                                                class="myObjectAttribute"
                                            />
                                            <ObjectAttribute
                                                title="{i18n>fieldCreationDate}"
                                                text="{pendientes>date_created}"
                                                class="myObjectAttribute"
                                            />
                                            <ObjectAttribute
                                                title="{i18n>fieldExFieldStartDate}"
                                                text="{pendientes>date_start}"
                                                class="myObjectAttribute"
                                            />
                                            <ObjectAttribute
                                                title="{i18n>FieldEndDate}"
                                                text="{pendientes>due_date}"
                                                class="myObjectAttribute"
                                            />
                                        </ObjectHeader>

                                        <VBox justifyContent="Center">
                                            
                                            <layoutData>
                                                <FlexItemData growFactor="1" />
                                            </layoutData>

                                            <Button
                                                text="{i18n>BtFinished}"
                                                press=".onPressCompleted"
                                                type="Emphasized"
                                                visible="{= ${pendientes>status} !== 'completed' }"
                                            />

                                        </VBox>
                                    </HBox>
                                </VBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

                <!--List
                    items="{
                        path: 'pendientes>/',
                        sorter: {
                            path: 'priority',
                            descending: false
                            }

                    }"
                >
                    <CustomListItem >
                    
                        <content>

                        </content>
                    </CustomListItem>

                    <ObjectListItem title="{pendientes>title}"
                                        number="{pendientes>priority}"
                                        visible="{!pendientes>editable}"
                                        press="onPressListItem"
                                        type="Active">

                        <firstStatus>
                            <ObjectStatus text="In Stock" state="Success"/>
                        </firstStatus>
                    
                    </ObjectListItem>

                </List-->
            </content>
        </Page>
    </Shell>
</mvc:View>
